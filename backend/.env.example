# Copy to your server environment (or use SetEnv in Apache / fpm pool config).
# These are read via getenv() in db.php.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yuki_content
DB_USER=root
DB_PASS=

# Comma-separated list of allowed frontend origins, or * for any (dev only).
CORS_ORIGIN=http://localhost:3000

# Optional shared secret. If set, write operations (create/update/delete/
# feature/import) require the X-Admin-Token header to match. Leave empty to
# disable (development only).
ADMIN_TOKEN=
