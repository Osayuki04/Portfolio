# Production environment variables for the Next.js app.
# Copy to .env.production (or set these in your host's dashboard) and fill in.
# NEVER commit the filled-in version — only this template is tracked.

# --- Content API (the PHP backend, deployed on Hostinger) -------------------
# Public base URL of the PHP front controller (index.php). The app appends
# ?path=/content etc. Must be HTTPS. With the site on Vercel (apex domain) and
# the PHP backend on Hostinger, put the backend on a subdomain:
NEXT_PUBLIC_CONTENT_API_URL=https://api.osayukiobazee.xyz/index.php
CONTENT_API_URL=https://api.osayukiobazee.xyz/index.php

# Shared secret the app sends to the PHP API on writes (X-Admin-Token).
# Set the SAME value here AND in the PHP host env (SetEnv ADMIN_TOKEN ... in
# backend/.htaccess, or the hosting panel). Generate: openssl rand -hex 32
ADMIN_TOKEN=

# --- Admin login (server-only — never shipped to the browser) ---------------
ADMIN_USERNAME=osayuki
ADMIN_PASSWORD=change-this-to-a-strong-password
# Signs the session cookie. Generate: openssl rand -hex 32
AUTH_SECRET=generate-a-new-32-byte-hex-secret
